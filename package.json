{
  "name": "megashelf",
  "version": "0.1.0-beta.3",
  "description": "Unified 3D emulation and PC game frontend",
  "author": "d-asai",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --windowed",
    "demo": "electron . --windowed --demo",
    "test": "node --test",
    "icons": "electron scripts/make-icons.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.d-asai.megashelf",
    "productName": "MegaShelf",
    "asar": false,
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png",
      "!node_modules/three/examples",
      "!node_modules/three/src",
      "!node_modules/three/build/*.min.js",
      "!node_modules/three/build/three.webgpu*",
      "!node_modules/three/build/three.tsl*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MegaShelf-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "d-asai",
        "repo": "thinkulator",
        "releaseType": "prerelease"
      }
    ]
  }
}
